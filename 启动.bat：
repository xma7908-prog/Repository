@echo off
title 龙虾管家 (OpenClaw) 智能引擎
color 0B

:: 【细节1】全自动获取管理员权限 (解决 50% 的运行失败)
>nul 2>&1 "%SYSTEMROOT%\system32\cacls.exe" "%SYSTEMROOT%\system32\config\system"
if '%errorlevel%' NEQ '0' (
    echo 正在请求最高权限，请在弹窗中点击“是”...
    goto UACPrompt
) else ( goto gotAdmin )
:UACPrompt
    echo Set UAC = CreateObject^("Shell.Application"^) > "%temp%\getadmin.vbs"
    echo UAC.ShellExecute "%~s0", "", "", "runas", 1 >> "%temp%\getadmin.vbs"
    "%temp%\getadmin.vbs"
    exit /B
:gotAdmin

echo ---------------------------------------------------
echo       🐉 龙虾管家 (OpenClaw) 自动化部署中
echo ---------------------------------------------------

:: 【细节2】自动唤醒 Docker (解决小白装了没开的问题)
tasklist | findstr /i "Docker Desktop.exe" >nul
if %errorlevel% neq 0 (
    echo [提示] 检测到 Docker 未运行，正在为您强制唤醒...
    start "" "C:\Program Files\Docker\Docker\Docker Desktop.exe"
    echo 请等待右下角小鲸鱼图标变绿后再按任意键继续...
    pause >nul
)

:: 【细节3】静默清理冲突容器
echo [进度] 正在优化运行环境...
docker rm -f openclaw >nul 2>&1

:: 【细节4】终极运行指令 (自动重启保护)
echo [进度] 正在启动 AI 服务，请稍候...
docker run -d --name openclaw -p 8080:8080 --restart always openclaw/openclaw:latest

echo ---------------------------------------------------
echo   🎉 部署大功告成！正在为您自动打开控制台...
echo ---------------------------------------------------
timeout /t 3 >nul
start http://localhost:8080
pause
